# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
*.xcuserdata
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
# Matching the directory itself (no trailing /*) excludes the directory, and a
# bare negation below it is a no-op -- git never descends into an excluded
# directory to find what to un-ignore. Matching contents instead lets the
# Package.resolved negation below actually take effect.
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!WXYCDJ.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# Generated Xcode project (regenerate via `xcodegen generate`)
# Keep tracked for now — uncomment to make project.yml the source of truth:
# WXYCDJ.xcodeproj/

# IDE
.vscode/
.idea/

# Local development worktrees (see the org CLAUDE.md git workflow)
.worktrees/
